{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyless.local/schemas/config.schema.json",
  "title": "Keyless project access request",
  "description": "Untrusted project-side request. This file never grants access; the vault-held grant is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "credentials"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "rootPathSha256"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "rootPathSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "provider",
          "methods",
          "paths",
          "queryParameters",
          "models",
          "limits"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "provider": {
            "enum": [
              "openai",
              "anthropic"
            ]
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "GET",
                "POST"
              ]
            }
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 256,
              "pattern": "^/(?:[A-Za-z0-9._~-]+|\\\\*)(?:/(?:[A-Za-z0-9._~-]+|\\\\*))*$",
              "not": {
                "pattern": "(^|/)(?:\\\\.|\\\\.\\\\.)(?:/|$)"
              },
              "description": "Normalized absolute API pathname. '*' is permitted only as a whole segment and matches exactly one segment. No percent encoding, dot segments, backslashes, partial '*' or '**'. Runtime must normalize and reject unsafe raw paths before matching."
            }
          },
          "queryParameters": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestsPerMinute",
              "requestsPerDay",
              "maxConcurrent",
              "maxRequestBytes",
              "maxResponseBytes"
            ],
            "properties": {
              "requestsPerMinute": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              },
              "requestsPerDay": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "maxConcurrent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "maxRequestBytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 10485760
              },
              "maxResponseBytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 67108864
              }
            }
          }
        }
      }
    }
  }
}
