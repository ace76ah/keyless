{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyless.local/schemas/grant.schema.json",
  "title": "Keyless vault-held project grant",
  "description": "Authoritative grant stored inside the encrypted vault. A project request cannot change this record without an approved exact diff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "grants",
    "tokens"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "rootPathSha256",
        "registeredAt",
        "revision"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "rootPathSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "grants": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "provider",
          "host",
          "enabled",
          "methods",
          "paths",
          "queryParameters",
          "models",
          "limits",
          "revision",
          "approval"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "provider": {
            "enum": [
              "openai",
              "anthropic"
            ]
          },
          "host": {
            "enum": [
              "api.openai.com",
              "api.anthropic.com"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "GET",
                "POST"
              ]
            }
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 256,
              "pattern": "^/(?:[A-Za-z0-9._~-]+|\\\\*)(?:/(?:[A-Za-z0-9._~-]+|\\\\*))*$",
              "not": {
                "pattern": "(^|/)(?:\\\\.|\\\\.\\\\.)(?:/|$)"
              },
              "description": "Normalized absolute API pathname. '*' is permitted only as a whole segment and matches exactly one segment. No percent encoding, dot segments, backslashes, partial '*' or '**'. Runtime must normalize and reject unsafe raw paths before matching."
            }
          },
          "queryParameters": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestsPerMinute",
              "requestsPerDay",
              "maxConcurrent",
              "maxRequestBytes",
              "maxResponseBytes"
            ],
            "properties": {
              "requestsPerMinute": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              },
              "requestsPerDay": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "maxConcurrent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "maxRequestBytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 10485760
              },
              "maxResponseBytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 67108864
              }
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approvedAt",
              "approvalHash",
              "requestDigest",
              "grantRevision",
              "mechanism"
            ],
            "properties": {
              "approvedAt": {
                "type": "string",
                "format": "date-time"
              },
              "approvalHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "requestDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "grantRevision": {
                "type": "integer",
                "minimum": 1
              },
              "mechanism": {
                "enum": [
                  "macos-local-authentication",
                  "windows-hello",
                  "linux-polkit",
                  "caller-tty-code"
                ]
              },
              "challengeExpiresAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tokenId",
          "tokenHashSha256",
          "issuedAt",
          "expiresAt",
          "status"
        ],
        "properties": {
          "tokenId": {
            "type": "string",
            "format": "uuid"
          },
          "tokenHashSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "active",
              "revoked",
              "expired"
            ]
          }
        }
      }
    }
  }
}
